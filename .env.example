# ============================================================
# 备课智能体 v2 · 网关与运行配置（个人账号）
# 使用方式：复制本文件为 .env，然后按你的账号填写。
# 注意：本文件是可分发的模板，不要在这里填真实 Key；真实 Key 只写在 .env。
#   所有生成内容（课程地图/教案/讲义/逐字稿）均由 AI 大模型产出，
#   未配置 LLM_API_KEY 时生成不可用（界面会提示），不使用内置模板。
#   默认使用最新豆包旗舰 doubao-seed-2-1-pro-260915（2026-09 发布）。
# ============================================================

# ---- 主模型（必填其一，任一 OpenAI 兼容服务）----

# 方式 A：豆包 / 火山方舟（推荐，默认已指向最新模型）
#   在 https://console.volcengine.com/ark 创建 API Key，并开通要用的模型
LLM_API_KEY=
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_MODEL=doubao-seed-2-1-pro-260915

# 方式 B：DeepSeek
#LLM_API_KEY=
#LLM_BASE_URL=https://api.deepseek.com
#LLM_MODEL=deepseek-v4-pro-ga-260813

# 方式 C：任意 OpenAI 兼容服务
#LLM_API_KEY=
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_MODEL=gpt-5

# ---- 轻量模型（意图/摘要等短任务用，可选；留空则走主模型）----
LLM_LITE_API_KEY=
LLM_LITE_BASE_URL=
LLM_LITE_MODEL=doubao-seed-2-1-lite-260915

# ---- 服务 ----
PORT=8000
# 单次模型调用超时（秒）
LLM_TIMEOUT=360

# ---- 学校 / 导出页眉 ----
SCHOOL_NAME=阳泉师范高等专科学校
# DOC_HEADER=阳泉师范高等专科学校教案

# ---- 生成与上传限制 ----
MAX_UPLOAD_MB=20
MAX_MATERIAL_CHARS=200000
MAX_CONTEXT_CHARS=16000
VAULT_TOP_K=3
# 校验不通过时自动修复结构一次（0=关闭）
AUTO_REPAIR=1

# ---- 数据与输出（一般无需修改；测试时可覆盖）----
# DB_PATH=./data.db
# OUTPUT_DIR=./output

# ---- 内置刊例价（元 / 百万 token，估算值，可按合同价修改）----
PRICING_DOUBAO_SEED_PRO=6.0,30.0
PRICING_DOUBAO_SEED_LITE=3.0,12.0
PRICING_DOUBAO_PRO=2.0,8.0
PRICING_DOUBAO_LITE=0.8,2.0
PRICING_DEEPSEEK=2.0,8.0
PRICING_OPENAI=15.0,60.0
